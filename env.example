# Copia aquest fitxer com a ".env" i omple'l. El fitxer .env NO es puja a GitHub.
# Project URL: https://<referencia-del-projecte>.supabase.co
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
# Clau SECRETA (Project Settings > API Keys > Secret keys, comença per sb_secret_).
# MAI a GitHub ni a la web.
SUPABASE_SECRET_KEY=

# Clau PÚBLICA (Project Settings > API Keys > Publishable key, comença per sb_publishable_).
# Només cal per a scripts/provar_login.py; és la mateixa que anirà a la web.
SUPABASE_PUBLISHABLE_KEY=
